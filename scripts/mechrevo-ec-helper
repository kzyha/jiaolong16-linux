#!/usr/bin/env bash
# mechrevo-ec-helper — MECHREVO 蛟龙 MRID6 EC 受控访问（DMS 插件后端）
# 源码母本: ~/bin/mechrevo-ec-helper → 安装到 /usr/local/sbin (root 属主)
# 用法: status | mode 0|1|2 | logo on|off | fnlock on|off | tplock on|off | color RRGGBB|default | gpu on|off|rtd3 | power | mux hybrid|discrete
# 前置: ec_sys 常驻且 write_support=1 (/etc/modules-load.d + /etc/modprobe.d 已配置)
# 寄存器(DSDT 实测): 0xE4=ITSM 模式(0性能/1游戏/2办公, TFLG 0xD0=0x55 握手)
#   0x9B-0x9E 双风扇 RPM(大端) 0x1C/0x1D CPU/GPU 温度 0x9A 背光档
#   0xE2 bit2=FWDE A面logo灯(低有效) 0x20 bit3=FNHK Fn锁 0x25 bit0=TOCP 触控板锁
#   0xD2=GPMD 显卡模式(0混合/1独显, 写前 GFLG 0xD1=0x55, 重启生效)
#   键盘灯: 0xE8=LEDM 模式(0=默认红/2=RGB自定义) 0xE9/EA/EB=RGBR/G/B(模式2下实时生效)
set -eu
IO=/sys/kernel/debug/ec/ec0/io
[ -e "$IO" ] || modprobe ec_sys write_support=1

case "${1:-}" in
  status)
    python3 - <<'PY'
d = open("/sys/kernel/debug/ec/ec0/io", "rb").read()
f1 = int.from_bytes(d[0x9B:0x9D], "big")
f2 = int.from_bytes(d[0x9D:0x9F], "big")
logo = 1 if (d[0xE2] & 0x04) == 0 else 0
print(f"mode={d[0xE4]} fan1={f1} fan2={f2} cpu={d[0x1C]} gpu={d[0x1D]} light={d[0x9A]} "
      f"logo={logo} fnlock={1 if d[0x20] & 0x08 else 0} tplock={d[0x25] & 1} mux={d[0xD2]} "
      f"kmode={d[0xE8]} kcolor={d[0xE9]:02X}{d[0xEA]:02X}{d[0xEB]:02X}")
PY
    ;;
  mode)
    case "${2:-}" in 0|1|2) ;; *) echo "error: mode must be 0|1|2" >&2; exit 2;; esac
    python3 - "$2" <<'PY'
import sys
v = int(sys.argv[1])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0xD0); f.write(bytes([0x55]))
f.seek(0xE4); f.write(bytes([v]))
f.seek(0xE4); cur = f.read(1)[0]
f.close()
print(f"ok mode={cur}" if cur == v else f"error: readback={cur}")
PY
    ;;
  logo)
    case "${2:-}" in
      on|1)  bit=0 ;;
      off|0) bit=1 ;;
      *) echo "error: logo must be on|off" >&2; exit 2;;
    esac
    python3 - "$bit" <<'PY'
import sys
bit = int(sys.argv[1])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0xE2); cur = f.read(1)[0]
f.seek(0xE2); f.write(bytes([(cur & 0xFB) | (bit << 2)]))
f.seek(0xE2); rb = f.read(1)[0]
f.close()
print(f"ok logo={'on' if (rb & 4) == 0 else 'off'}")
PY
    ;;
  fnlock)
    case "${2:-}" in
      on|1)  bit=1 ;;
      off|0) bit=0 ;;
      *) echo "error: fnlock must be on|off" >&2; exit 2;;
    esac
    python3 - "$bit" <<'PY'
import sys
bit = int(sys.argv[1])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0x20); cur = f.read(1)[0]
f.seek(0x20); f.write(bytes([(cur & 0xF7) | (bit << 3)]))
f.seek(0x20); rb = f.read(1)[0]
f.close()
print(f"ok fnlock={'on' if rb & 8 else 'off'}")
PY
    ;;
  tplock)
    case "${2:-}" in
      on|1)  bit=1 ;;
      off|0) bit=0 ;;
      *) echo "error: tplock must be on|off" >&2; exit 2;;
    esac
    python3 - "$bit" <<'PY'
import sys
bit = int(sys.argv[1])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0x25); cur = f.read(1)[0]
f.seek(0x25); f.write(bytes([(cur & 0xFE) | bit]))
f.seek(0x25); rb = f.read(1)[0]
f.close()
print(f"ok tplock={'on' if rb & 1 else 'off'}")
PY
    ;;
  color)
    case "${2:-}" in
      default|reset) MODE=0; R=0; G=0; B=0 ;;
      [0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f])
        R=$((16#${2:0:2})); G=$((16#${2:2:2})); B=$((16#${2:4:2})); MODE=2 ;;
      *) echo "error: color must be RRGGBB hex or default" >&2; exit 2;;
    esac
    python3 - "$MODE" "$R" "$G" "$B" <<'PY'
import sys
mode, r, g, b = (int(x) for x in sys.argv[1:5])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0xE9); f.write(bytes([r]))
f.seek(0xEA); f.write(bytes([g]))
f.seek(0xEB); f.write(bytes([b]))
f.seek(0xE8); f.write(bytes([mode]))
f.seek(0xE8); m = f.read(1)[0]
f.close()
print(f"ok color mode={m}")
PY
    ;;
  gpu)
    case "${2:-}" in
      on)
        echo 1 > /sys/bus/pci/rescan
        modprobe nvidia_drm nvidia_uvm 2>/dev/null || true
        OK=0
        for i in 1 2 3 4 5 6 7 8; do
            sleep 1
            if [ -d /sys/bus/pci/devices/0000:01:00.0 ] && lsmod | grep -q "^nvidia "; then
                OK=1; break
            fi
            modprobe nvidia_drm nvidia_uvm 2>/dev/null || true
        done
        if [ "$OK" = 1 ]; then
            echo "ok gpu=on"
        else
            echo "error: 独显恢复失败"; exit 1
        fi
        ;;
      off)
        HOLDERS=""
        for p in /proc/[0-9]*; do
            if ls -l $p/fd 2>/dev/null | grep -qE "/dev/(nvidia|dri/by-path/pci-0000:01:00.0|dri/renderD129)"; then
                HOLDERS="$HOLDERS $(cat $p/comm 2>/dev/null)"
            fi
        done
        if [ -n "$HOLDERS" ]; then
            echo "error: 独显被占用,重启后恢复屏蔽:$HOLDERS" >&2; exit 1
        fi
        modprobe -r nvidia_uvm nvidia_drm nvidia_modeset nvidia 2>/dev/null || true
        if lsmod | grep -q "^nvidia "; then
            echo "error: 模块卸载失败,中止" >&2; exit 1
        fi
        [ -e /sys/bus/pci/devices/0000:01:00.0 ] && echo 1 > /sys/bus/pci/devices/0000:01:00.0/remove
        echo "ok gpu=off"
        ;;
      rtd3)
        # 中途拔电场景: 不动设备, 只确保运行时电源管理激进
        for d in 0000:01:00.0 0000:00:01.1; do
            [ -e /sys/bus/pci/devices/$d/power/control ] && echo auto > /sys/bus/pci/devices/$d/power/control 2>/dev/null || true
        done
        nvidia-smi -pm 0 > /dev/null 2>&1 || true
        echo "ok gpu=rtd3 state=$(cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status 2>/dev/null)"
        ;;
      *) echo "error: gpu must be on|off|rtd3" >&2; exit 2;;
    esac
    ;;
  power|powerlog)
    LOG=""
    [ "$1" = "powerlog" ] && LOG=1
    python3 - "$LOG" <<'PY2'
import time, subprocess, os, sys
LOG = sys.argv[1] == "1"
def rd(p):
    try: return open(p).read().strip()
    except Exception: return ""
ac = "1" if rd("/sys/class/power_supply/ADP1/online") == "1" else "0"
try: bat = int(rd("/sys/class/power_supply/BAT0/power_now")) / 1e6
except Exception: bat = 0.0
def _gpu_usable():
    p = "/sys/bus/pci/devices/0000:01:00.0"
    if not os.path.exists(p):
        return "0"
    try:
        drv = os.path.basename(os.readlink(p + "/driver"))
        return "1" if drv == "nvidia" else "0"
    except OSError:
        return "0"
gstate = _gpu_usable()
gpu = 0.0
if gstate == "1":
    try:
        out = subprocess.run(["nvidia-smi","--query-gpu=power.draw","--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=2).stdout
        gpu = float(out.strip().split(chr(10))[0])
    except Exception: gpu = 0.0
cpu = 0.0
try:
    e1 = int(rd("/sys/class/powercap/intel-rapl:0/energy_uj"))
    time.sleep(0.3)
    e2 = int(rd("/sys/class/powercap/intel-rapl:0/energy_uj"))
    mx = int(rd("/sys/class/powercap/intel-rapl:0/max_energy_range_uj"))
    if e2 < e1: e2 += mx
    cpu = (e2 - e1) / 1e6 / 0.3
except Exception: pass
line = f"ac={ac} bat={bat:.1f} cpu={cpu:.1f} gpu={gpu:.1f} gstate={gstate}"
if LOG:
    with open("/var/log/mechrevo-power.log", "a") as f:
        f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + line + chr(10))
print(line)
PY2
    ;;
  mux)
    case "${2:-}" in
      hybrid|0)   v=0 ;;
      discrete|1) v=1 ;;
      *) echo "error: mux must be hybrid|discrete" >&2; exit 2;;
    esac
    python3 - "$v" <<'PY'
import sys
v = int(sys.argv[1])
f = open("/sys/kernel/debug/ec/ec0/io", "r+b", 0)
f.seek(0xD1); f.write(bytes([0x55]))   # GFLG 握手
f.seek(0xD2); f.write(bytes([v]))      # GPMD
f.seek(0xD2); rb = f.read(1)[0]
f.close()
print(f"ok mux={'discrete' if rb == 1 else 'hybrid'} (重启后生效)")
PY
    ;;
  *)
    echo "error: usage: $0 status | mode 0|1|2 | logo on|off | fnlock on|off | tplock on|off | color RRGGBB|default | gpu on|off|rtd3 | power | mux hybrid|discrete" >&2; exit 2;;
esac
